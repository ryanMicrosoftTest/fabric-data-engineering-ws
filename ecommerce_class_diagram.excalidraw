      "y": 294,
      "width": 390,
      "height": 168,
      "text": "\n+ add_item(product, qty) : CartItem\n+ remove_item(product_id) : None\n+ subtotal() : Decimal\n+ checkout(payment) : Order\n",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "cls2-meth",
      "originalText": "\n+ add_item(product, qty) : CartItem\n+ remove_item(product_id) : None\n+ subtotal() : Decimal\n+ checkout(payment) : Order\n",
      "lineHeight": 1.25,
      "baseline": 14
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
