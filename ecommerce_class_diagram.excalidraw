      "id": "cls10-desc",
      "type": "text",
      "x": 700,
      "y": 3532,
      "width": 300,
      "height": 384,
      "text": "CLASS: Payment: A payment\nattempt against an order.\n\nMETHODS:\n+ authorize(): Reserve funds\nwith the payment processor.\n\n+ capture(): Settle the\npreviously authorized\namount.\n\n+ refund(amount): Refund all\nor part of the captured\namount.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CLASS: Payment: A payment\nattempt against an order.\n\nMETHODS:\n+ authorize(): Reserve funds\nwith the payment processor.\n\n+ capture(): Settle the\npreviously authorized\namount.\n\n+ refund(amount): Refund all\nor part of the captured\namount.",
      "lineHeight": 1.25,
      "baseline": 18
    },
