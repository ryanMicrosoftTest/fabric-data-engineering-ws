      "updated": 1777392896207,
      "link": null,
      "locked": false,
      "id": "cls2-desc",
      "type": "text",
      "x": 1290,
      "y": 492,
      "width": 390,
      "height": 462,
      "text": "CLASS: Cart: The customer's\nin-progress shopping cart prior to\ncheckout.\n\nMETHODS:\n+ add_item(product, qty): Add a\nproduct to the cart, merging with an\nexisting line if present.\n\n+ remove_item(product_id): Remove a\nline from the cart.\n\n+ subtotal(): Sum of all line totals\nbefore tax and shipping.\n\n+ checkout(payment): Convert the cart\ninto a paid order.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CLASS: Cart: The customer's\nin-progress shopping cart prior to\ncheckout.\n\nMETHODS:\n+ add_item(product, qty): Add a\nproduct to the cart, merging with an\nexisting line if present.\n\n+ remove_item(product_id): Remove a\nline from the cart.\n\n+ subtotal(): Sum of all line totals\nbefore tax and shipping.\n\n+ checkout(payment): Convert the cart\ninto a paid order.",
      "lineHeight": 1.25,
      "baseline": 18
    },
