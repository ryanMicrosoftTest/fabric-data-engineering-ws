    {
      "id": "fQP5x9dMjcGeRGsrfxJX0",
      "type": "text",
      "x": 2889.6157924107147,
      "y": 547.3570927211208,
      "width": 155.33984375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
