/* =====================================================================
   Interim cross-tenant sharing — SQL permission layer
   Generated by Terraform. Do not edit in place; edit the .tftpl.

   Target: ${database} @ ${server}
   Model:  delegated identity endpoint + passthrough shortcut + ownership chaining

   This script is the entire security boundary for the consuming principal.
   It is only load-bearing while the endpoint is in DELEGATED IDENTITY mode.
   ===================================================================== */

/* ---------------------------------------------------------------------
   1. Curated views
   Recreated every apply so the definition in Terraform is authoritative.
   CREATE VIEW must be the first statement in its batch, hence the GO fencing.
   --------------------------------------------------------------------- */
%{ for v in views ~}

DROP VIEW IF EXISTS [dbo].[${v.name}];
GO

CREATE VIEW [dbo].[${v.name}]
AS
SELECT ${v.columns}
FROM   [${shortcut_schema}].[${v.source_table}]
%{ if v.where != null && v.where != "" ~}
WHERE  ${v.where}
%{ endif ~}
;
GO
%{ endfor ~}

/* ---------------------------------------------------------------------
   2. Consuming principal
   Contained user mapped to Entra. No login, no server-level rights.
   --------------------------------------------------------------------- */
IF NOT EXISTS (
    SELECT 1 FROM sys.database_principals WHERE name = N'${consumer_upn}'
)
BEGIN
    CREATE USER [${consumer_upn}] FROM EXTERNAL PROVIDER;
END
GO

/* CONNECT is implicit on CREATE USER; stated explicitly so the intended
   permission set is fully described by this file. */
GRANT CONNECT TO [${consumer_upn}];
GO

/* ---------------------------------------------------------------------
   3. The grant — the ONLY read path the consumer has
   Object-level (class 1). Ownership chaining carries the read through the
   passthrough shortcut under the endpoint's delegated identity, so the
   consumer needs nothing at the producer.
   --------------------------------------------------------------------- */
%{ for v in views ~}
GRANT SELECT ON OBJECT::[dbo].[${v.name}] TO [${consumer_upn}];
%{ endfor ~}
GO

/* ---------------------------------------------------------------------
   4. The deny — containment
   Blocks direct reads of the shortcut schema AND removes it from metadata,
   so the base tables do not appear in Object Explorer.

   Note this DENY is never evaluated on the view path: ownership chaining
   skips permission checks on base objects entirely when the chain is intact.
   It exists to survive a future over-grant (db_datareader, schema grant),
   not to constrain what the view exposes.
   --------------------------------------------------------------------- */
DENY SELECT ON SCHEMA::[${shortcut_schema}] TO [${consumer_upn}];
GO

/* ---------------------------------------------------------------------
   5. Metadata hardening
   --------------------------------------------------------------------- */
DENY VIEW DEFINITION ON SCHEMA::[${shortcut_schema}] TO [${consumer_upn}];
GO
